{"type":"record","version":2,"saved_at":"2026-09-17T11:11:21+08:00","record":{"name":"Hsiao-Rong Chen","current_title":"Senior Scientific Lead, Discovery Bioinformatics","current_company":"礼来","location":"美国 加利福尼亚 南旧金山","headline":"Senior Scientific Lead, Discovery Bioinformatics at Eli Lilly","public_url":"https://www.linkedin.com/in/hsiao-rong-chen","recruiter_url":"https://www.linkedin.com/talent/profile/AEMAAA_wbPMB7GJ9lFRl10frqhqD5qJtIO1E76Y","core_skills":["Bioinformatic","Transfection","Python"],"positions":[{"title":"Senior Scientific Lead, Discovery Bioinformatics","company":"礼来","date_range":"5 年 7 个月","duration":"3 年 10 个月","location":"","description":"","skills":[]},{"title":"Principle Scientist, Discovery Bioinformatics","company":"礼来","date_range":"5 年 7 个月","duration":"3 年 10 个月","location":"","description":"","skills":[]},{"title":"Computational Biologist","company":"Lyell Immunopharma","date_range":"2019年 - 2021年2月","duration":"2 年 2 个月","location":"","description":"Utilized state-of-the-art bioinformatics methodologies to conduct comprehensive analyses of bulk and single-cell RNA-Seq, ATAC-Seq, and CITE-Seq datasets, with the objective of enhancing the efficacy of CAR-T therapy.","skills":[]},{"title":"Assistant Bioinformatics Scientist","company":"Winship Cancer Institute of Emory University","date_range":"2017年9月 - 2019年7月","duration":"1 年 11 个月","location":"","description":"Collaborated with Winship clinical investigators and oncologists by providing support in cancer research study design, NGS data analysis, interpretation, and assessment of clinical/therapeutic relevance","skills":[]},{"title":"Bioinformatics Specialist","company":"Ragon Institute of MGH, MIT and Harvard","date_range":"2016年7月 - 2017年8月","duration":"1 年 2 个月","location":"波士顿地区","description":"Lead Bioinformatics effort and collaborated with Biologists to explore the immunological responses provoked by HIV and Zika infections, concurrently developing in-house analysis pipelines