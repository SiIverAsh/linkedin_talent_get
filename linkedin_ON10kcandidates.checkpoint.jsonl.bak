{"type":"record","version":2,"saved_at":"2026-09-17T10:57:53+08:00","record":{"name":"Jane Chang","current_title":"Consultant Toxicologist","current_company":"JC Reg Tox Consulting","location":"美国 德拉瓦 威尔明顿","headline":"Principle of JC Reg Tox Consulting","public_url":"https://www.linkedin.com/in/jane-chang-51a19720","recruiter_url":"https://www.linkedin.com/talent/profile/AEMAAARMVyYBUMj7GCv1NNVsoV0edJ31H5kZ-NE","core_skills":["Pharmaceutical Industry","Assay Development","Therapeutic Areas"],"positions":[{"title":"Consultant Toxicologist","company":"JC Reg Tox Consulting","date_range":"2015年1月 - 现在","duration":"11 年 9 个月","location":"West Chester, PA","description":"","skills":[]},{"title":"Preclinical Project Director","company":"AstraZeneca Pharmaceuticals","date_range":"2000年 - 现在","duration":"26 年 9 个月","location":"","description":"Lead and provide safety assessment strategy \nLead and author preclinical documents for regulatory submission (from pre-IND consultation to NDA approval) \nRepresent AstraZeneca in meetings with FDA \nPerform due diligence, collaborate with external partners \nManage toxicology program (time and cost), monitor studies \nProduct safety defense, life cycle management","skills":[]},{"title":"Sr. Research Scientist II","company":"Wyeth Pharmaceuticals","date_range":"1995年12月 - 2000年6月","duration":"4 年 7 个月","location":"Chazy, NY","description":"Member of drug development teams (biologics and small molecules); covering various therapeutic areas \nStudy director; study monitor \nAuthor regulatory documents for international submission","skills":[]},{"title":"Staff Toxicologist","company":"Ciba-Geigy","date_range":"1988年11月 - 1995年12月","duration":"7 年 2 个月","location":"Farmington, CT","description":"Study director for GLP acute, subchronic, chronic, neurotoxicity, and carcinogenicity studies on pesticides \nDevelop special procedures into standard operating procedures, solve provlem for technical staff \nWorking knowledge of EPA, MAFF, OECD